		"devdoc": {
			"details": "Interface for the RewardPoints contract. Defines all external functions, events, and errors for the Reward Points System.",
			"kind": "dev",
			"methods": {
				"balanceOf(address)": {
					"params": {
						"user": "The address to check"
					},
					"returns": {
						"_0": "balance Current redeemable points balance"
					}
				},
				"earnPoints(address,uint256)": {
					"params": {
						"amount": "The base amount of points to award (before multiplier)",
						"user": "The address to award points to"
					}
				},
				"getTier(address)": {
					"params": {
						"user": "The address to check"
					},
					"returns": {
						"_0": "tier The current tier (0=Bronze, 1=Silver, 2=Gold, 3=Platinum)"
					}
				},
				"getTierMultiplier(uint8)": {
					"params": {
						"tier": "The tier to get multiplier for"
					}
				},
				"getTierThreshold(uint8)": {
					"params": {
						"tier": "The tier to get threshold for"
					}
				},
				"redeemPoints(uint256)": {
					"params": {
						"amount": "The amount of points to redeem"
					}
				},
				"setMinRedemption(uint256)": {
					"params": {
						"amount": "The new minimum redemption amount"
					}
				},
				"setMultiplier(uint256)": {
					"params": {
						"newMultiplier": "The new multiplier value"
					}
				},
				"totalPointsEarned(address)": {
					"params": {
						"user": "The address to check"
					},
					"returns": {
						"_0": "totalPoints Total lifetime points earned"
					}
				}
			},
			"title": "IRewardPoints",
			"version": 1
		},
		"userdoc": {
			"events": {
				"MultiplierUpdated(uint256)": {
					"notice": "Emitted when the global multiplier is updated by the owner"
				},
				"PointsEarned(address,uint256,uint8)": {
					"notice": "Emitted when points are earned by a user"
				},
				"PointsRedeemed(address,uint256)": {
					"notice": "Emitted when points are redeemed by a user"
				},
				"TierChanged(address,uint8,uint8)": {
					"notice": "Emitted when a user's tier changes"
				}
			},
			"kind": "user",
			"methods": {
				"balanceOf(address)": {
					"notice": "Returns the current redeemable points balance of a user"
				},
				"earnPoints(address,uint256)": {
					"notice": "Awards points to a user (callable by owner or minter role)"
				},
				"getMinRedemption()": {
					"notice": "Returns the current minimum redemption threshold"
				},
				"getMultiplier()": {
					"notice": "Returns the current global multiplier (basis points)"
				},
				"getTier(address)": {
					"notice": "Returns the current tier of a user"
				},
				"getTierMultiplier(uint8)": {
					"notice": "Returns the multiplier for a given tier (basis points)"
				},
				"getTierThreshold(uint8)": {
					"notice": "Returns the points threshold required for a given tier"
				},
				"pause()": {
					"notice": "Pauses all user-facing functions"
				},
				"redeemPoints(uint256)": {
					"notice": "Redeems points for rewards (callable by the point holder)"
				},
				"setMinRedemption(uint256)": {
					"notice": "Sets the minimum redemption threshold"
				},
				"setMultiplier(uint256)": {
					"notice": "Sets the global earning multiplier (basis points, 10000 = 1x)"
				},
				"totalPointsEarned(address)": {
					"notice": "Returns the total points earned by a user (lifetime)"
				},
				"unpause()": {
					"notice": "Unpauses all user-facing functions"
				}
			},
			"version": 1
		}
